{
  "variables": [
    {
      "name": "PUBLIC_SITE_URL",
      "classification": "public",
      "requiredIn": ["production"],
      "default": "https://castiliad.github.io/agentsite-control-plane/",
      "validation": "^https://castiliad.github.io/agentsite-control-plane/?$"
    },
    {
      "name": "STRIPE_PAYMENT_LINK",
      "classification": "public_static_output",
      "requiredIn": ["live_payment"],
      "default": "https://buy.stripe.com/test_PLACEHOLDER",
      "validation": "^https://(buy|checkout)\\.stripe\\.com/"
    }
  ]
}
