---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Checkout Canceled — AgentSite" robots="noindex,follow">
  <main id="main" class="section-shell hero compact-page">
    <p class="eyebrow">Canceled</p>
    <h1>Checkout was canceled.</h1>
    <p class="lede">This page is ready for Stripe Payment Link cancel redirects.</p>
    <a class="button secondary" href={base}>Return home</a>
  </main>
</BaseLayout>
