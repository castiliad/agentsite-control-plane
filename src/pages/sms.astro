---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="SMS Information — Hermes Personal Assistant" description="SMS opt-in, opt-out, HELP, STOP, and messaging details for Hermes Personal Assistant.">
  <main id="main" class="section-shell compact-page legal-page">
    <nav class="nav" aria-label="Primary">
      <a class="brand" href={base} aria-label="AgentSite home"><span class="brand-mark" aria-hidden="true"></span> AgentSite</a>
      <div class="nav-links">
        <a class="nav-link" href={`${base}privacy/`}>Privacy</a>
        <a class="nav-link" href={`${base}terms/`}>Terms</a>
        <a class="nav-link" href={site.repoUrl}>GitHub</a>
      </div>
    </nav>

    <p class="eyebrow">SMS program</p>
    <h1>Hermes Personal Assistant SMS</h1>
    <p class="lede">SMS is used for private assistant messages such as alerts, reminders, status updates, and conversational replies to authorized users.</p>

    <section class="text-card legal-card">
      <h2>Opt-in</h2>
      <p>Users opt in by texting the service number directly or by being manually configured as an authorized recipient for the private Hermes Personal Assistant workflow. This page, the <a href={`${base}privacy/`}>Privacy Policy</a>, and the <a href={`${base}terms/`}>Terms of Service</a> describe the messaging program.</p>

      <h2>Message types</h2>
      <ul class="plain-list">
        <li>Assistant replies to inbound SMS messages.</li>
        <li>Personal reminders and requested notifications.</li>
        <li>Operational alerts, status updates, and monitoring notifications.</li>
      </ul>

      <h2>Frequency and cost</h2>
      <p>Message frequency varies. Message and data rates may apply depending on your carrier plan.</p>

      <h2>Opt-out</h2>
      <p>Reply <strong>STOP</strong> at any time to opt out. After opting out, you may receive a final confirmation message and then no further SMS messages unless you opt in again.</p>

      <h2>Help</h2>
      <p>Reply <strong>HELP</strong> for help. You can also review this page for messaging details and use the GitHub repository contact path: <a href={site.repoUrl}>{site.repoUrl}</a>.</p>

      <h2>Privacy note</h2>
      <p><strong>SMS opt-in data and consent are not sold, rented, or shared with third parties for marketing or promotional purposes.</strong> See the <a href={`${base}privacy/`}>Privacy Policy</a> for more detail.</p>

      <h2>Sample messages</h2>
      <ul class="plain-list">
        <li>Hermes: Reminder — leave in 15 minutes for your appointment. Reply STOP to opt out.</li>
        <li>Hermes: The home assistant gateway is offline. I’ll retry monitoring in 5 minutes. Reply HELP for help.</li>
        <li>Hermes: Got it. I’ll summarize that note and save it for later.</li>
      </ul>
    </section>
  </main>
</BaseLayout>
